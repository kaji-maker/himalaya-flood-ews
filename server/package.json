{
  "name": "himalaya-flood-ews-server",
  "version": "0.1.0",
  "description": "Core Spatial API & GLOF Alert Dispatcher for Himalaya Flood EWS",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "jest --detectOpenHandles --forceExit",
    "test:live": "python3 ../scripts/verify_live_feeds.py",
    "research:smoke": "node dist/scripts/nebius_smoke.js",
    "db:migrate": "node dist/scripts/db_migrate.js",
    "dhm:thresholds-sync": "node dist/scripts/dhm_thresholds_sync.js",
    "hydrology:smoke": "node dist/scripts/hydrology_smoke.js",
    "hydrology:backtest": "node dist/scripts/hydrology_backtest.js",
    "hydrology:replay-smoke": "node dist/scripts/hydrology_replay_smoke.js",
    "dhm:sync": "node dist/scripts/dhm_ingestion.js --once",
    "dhm:daemon": "node dist/scripts/dhm_ingestion.js",
    "dhm:smoke": "node dist/scripts/dhm_ingestion_smoke.js",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
