# Himalaya Flood & GLOF Early Warning System (EWS)
# Environment Configuration

PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://ews_admin:ews_secure_password@localhost:5435/himalaya_ews
REDIS_URL=redis://localhost:6380
ALERT_WEBHOOK_URL=http://localhost:4000/api/v1/alerts/webhook-mock

# Real-World Data Pipeline Configuration
NEXT_PUBLIC_DEMO_MODE=false
LIVE_DATA=true
DEMO_MODE=false

# Satellite STAC API (Element 84 AWS Earth Search - Open Access)
SENTINEL_STAC_URL=https://earth-search.aws.element84.com/v1

# Copernicus Data Space Ecosystem (Optional Fallback)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Nebius Token Factory (backend-only experimental research summaries)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MAX_TOKENS=900

# Scheduled DHM research ingestion: dedicated backend worker, no Nebius calls.
DHM_POLL_INTERVAL_SECONDS=900
DHM_RAINFALL_STATION_IDS=55,57,107,408,663,923
HYDROLOGY_SYNC_TOKEN=
